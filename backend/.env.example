# Configuración de Entorno para Manto 2.0 Backend
#
# Copia este archivo a `.env` y ajusta lo que necesites.
# Nada de esto es obligatorio para levantar el backend en desarrollo: los
# adaptadores de pagos y visión caen a modo simulado si les falta la llave.

# 3003 a propósito. El frontend corre en 3002, y ni 3000 ni 3001 se usan:
# quedaron descartados porque en la máquina de desarrollo algo los tenía
# tomados y el navegador devolvía ERR_CONNECTION_REFUSED.
PORT=3003
NODE_ENV=development

# --- Base de datos PostgreSQL 16 ---
#
# SIN ESTO el backend arranca con repositorios en memoria y todo lo que emita
# se pierde al reiniciar el proceso. No es un modo de operación.
#
# La forma más corta de tenerla en Windows, desde la raíz del repositorio:
#   docker compose up -d
#
# Ese compose publica el puerto 5433 para no chocar con un Postgres instalado.
# Las migraciones se aplican solas al arrancar el backend.
DATABASE_URL=postgresql://manto_app:manto_secure_dev_password@localhost:5433/manto_db

# Alternativa por partes, si prefieres no usar DATABASE_URL.
# DATABASE_HOST=localhost
# DATABASE_PORT=5433
# DATABASE_USER=manto_app
# DATABASE_PASSWORD=manto_secure_dev_password
# DATABASE_NAME=manto_db
# El esquema es fijo, `insurance`, y no se configura: era una variable que se
# interpolaba en el SQL (una inyección) y que además no servía para nada, porque
# las migraciones nombran `insurance` explícitamente.
DATABASE_POOL_MAX=10

# Azure Database for PostgreSQL exige TLS. En local, no.
# DATABASE_SSL=true

# --- Lo que sigue NO lo lee el código todavía. Queda declarado para cuando
# --- entren la base de datos, la autenticación y el almacenamiento.

# Autenticación y Seguridad
JWT_SECRET=super_secret_jwt_key_manto_dev_environment_min_32_chars
JWT_EXPIRATION_SECONDS=900
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_manto_dev_min_32_chars
JWT_REFRESH_EXPIRATION_SECONDS=604800

# Redis & Colas BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Pagos: MercadoPago.
# Sin token, el adaptador corre en modo simulado y el checkout devuelve un
# enlace de prueba. El código nunca integró Wompi; estas variables estaban
# aquí de una versión anterior del plan y no las lee nadie.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Visión: Gemini 2.0 Flash.
# Sin llave, el proveedor cae al mock, que devuelve raza mestiza con confianza
# baja para forzar que Nuquí pregunte en vez de afirmar.
GEMINI_API_KEY=

# Reembolsos: Bre-B (Sistema de Pagos Inmediatos del Banco de la República).
# Sin llave, el adaptador corre en modo simulado.
BRE_B_API_URL=
BRE_B_API_KEY=

# Almacenamiento S3 / MinIO
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_DOCUMENTS=manto-documents-dev
