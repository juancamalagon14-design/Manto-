# ==============================================================================
# Manto 2.0 - Production Environment Variables Template (.env)
# Copy to .env on production host and configure with secure secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# Domain & Reverse Proxy (Caddy)
# ------------------------------------------------------------------------------
DOMAIN_NAME=manto.com.co
ACME_EMAIL=ops@manto.com.co

# ------------------------------------------------------------------------------
# PostgreSQL 16 Database
# ------------------------------------------------------------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=manto_app
DATABASE_PASSWORD=manto_super_secure_production_password_2026!
DATABASE_NAME=manto_db
DATABASE_POOL_MAX=20

# ------------------------------------------------------------------------------
# Backend NestJS Secrets & Configuration
# ------------------------------------------------------------------------------
PORT=3003
JWT_SECRET=super_secret_jwt_random_key_min_64_chars_manto_production_2026
MERCADOPAGO_ACCESS_TOKEN=APP_USR-your-production-mercadopago-token
GEMINI_API_KEY=AIzaSyYourProductionGeminiApiKey

# ------------------------------------------------------------------------------
# Frontend Next.js Build & Runtime
# ------------------------------------------------------------------------------
# For production single-domain deployment via Caddy reverse proxy,
# the frontend communicates with the backend via relative path /v1 or direct internal host.
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_API_URL=https://manto.com.co/v1
NEXT_PUBLIC_APP_ENV=production
